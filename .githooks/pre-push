#!/bin/sh
# Slower checks before code leaves the machine: env-file guard, then svelte-check.
# pnpm check loads env through varlock, so the Proton Pass CLI must be signed in.
# Skip once with: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

# Never let env files leave the machine, even if one slipped into a commit with --no-verify.
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then base="origin/master"; else base="$remote_sha"; fi
  git diff --name-only --diff-filter=ACMR "$base" "$local_sha" | scripts/check-no-env-files.sh
done

pnpm check
