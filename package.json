{
  "name": "personal-website-sveltekit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "NODE_OPTIONS=\"--inspect\" vite dev --host",
    "build": "vite build",
    "start": "varlock run -- node build/index.js",
    "preview": "vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "test:ui": "svelte-kit sync && playwright test --ui",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "organize": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "storybook": "storybook dev -p 6006",
    "test:integration": "playwright test",
    "test:unit": "ENVIRONMENT=test vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@chromatic-com/storybook": "^5.6.0",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/sveltekit": "^10.6.7",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@varlock/bitwarden-plugin": "^2.0.2",
    "@varlock/proton-pass-plugin": "^2.0.2",
    "@varlock/vite-integration": "^1.5.5",
    "just-intersect": "^4.3.0",
    "postcss": "^8.5.32",
    "postcss-custom-media": "^12.0.3",
    "postcss-import": "^17.0.1",
    "postcss-load-config": "^6.0.1",
    "postcss-preset-env": "^11.6.2",
    "storybook": "^10.6.7",
    "svelte-check": "^4.7.8",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-imagetools": "^12.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^11.12.0",
    "@sentry/sveltekit": "^11.12.0",
    "@sveltejs/kit": "^3.2.0",
    "bits-ui": "2.21.0",
    "ioredis": "^6.0.0",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "scrape-it": "^6.1.16",
    "svelte": "^5.57.3",
    "svelte-meta-tags": "^5.0.3",
    "varlock": "^1.24.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
